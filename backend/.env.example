APP_ENV=development
DEBUG=false

# Copie este arquivo para .env e substitua CHANGE_ME.
DATABASE_URL=postgresql+psycopg://auneron:CHANGE_ME@localhost:5432/auneron

# Gere uma chave aleatória com pelo menos 32 caracteres.
API_KEY=CHANGE_ME_WITH_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS

# Nível dos logs estruturados do Auneron.
LOG_LEVEL=INFO

# Pool e proteção operacional do PostgreSQL.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=900
DATABASE_CONNECT_TIMEOUT=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
DATABASE_APPLICATION_NAME=auneron-api

DATABASE_ECHO=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
