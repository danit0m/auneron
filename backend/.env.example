APP_ENV=development
DEBUG=false

# Execução direta do backend no Windows.
DATABASE_URL=postgresql+psycopg://auneron:CHANGE_ME@localhost:5432/auneron

# Gere uma chave aleatória com pelo menos 32 caracteres.
# Em production, não use placeholders nem valores previsíveis.
API_KEY=CHANGE_ME_WITH_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS

# Sessão de usuário.
# O token bruto existe somente no cookie HttpOnly do navegador.
AUTH_COOKIE_NAME=auneron_session
AUTH_SESSION_TTL_MINUTES=480
AUTH_ELEVATION_TTL_MINUTES=10

# Proteção contra brute force e password spraying.
# O limiter é por processo; os identificadores de conta/IP são
# mantidos apenas como SHA-256 em memória.
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=25
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_ELEVATION_USER_MAX_FAILURES=5
AUTH_ELEVATION_IP_MAX_FAILURES=15
AUTH_ELEVATION_WINDOW_SECONDS=600

# Manutenção de sessões.
# Sessões expiradas são removidas. Sessões revogadas ainda válidas
# permanecem pelo período de retenção abaixo antes da limpeza.
AUTH_SESSION_CLEANUP_INTERVAL_SECONDS=3600
AUTH_REVOKED_SESSION_RETENTION_HOURS=24

# Nível dos logs estruturados do Auneron.
LOG_LEVEL=INFO

# Pool e proteção operacional do PostgreSQL.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=900
DATABASE_CONNECT_TIMEOUT=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
DATABASE_APPLICATION_NAME=auneron-api

DATABASE_ECHO=false

# Desenvolvimento local com frontend Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Production:
# - use CORS_ORIGINS vazio quando frontend e API forem same-origin;
# - caso exista origem cross-origin, informe somente HTTPS;
# - wildcard '*' não é aceito com credenciais.
# CORS_ORIGINS=

# Docker Compose local.
# POSTGRES_PASSWORD deve corresponder ao password usado na primeira
# inicialização do volume auneron_postgres_data.
POSTGRES_PASSWORD=auneron_dev_password
POSTGRES_PORT=5433
BACKEND_HTTP_PORT=8000
AUNERON_HTTP_PORT=8080
