APP_ENV=development
DEBUG=false

# Copie este arquivo para .env e substitua CHANGE_ME.
DATABASE_URL=postgresql+psycopg://auneron:CHANGE_ME@localhost:5432/auneron

DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
