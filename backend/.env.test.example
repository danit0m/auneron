# Copie este arquivo para .env.test.
# Substitua CHANGE_ME pela senha local do papel auneron.
# Use uma chave de teste com pelo menos 32 caracteres.
# Este arquivo de exemplo pode ser versionado.
# O arquivo .env.test real nunca deve ser versionado.

TEST_DATABASE_URL=postgresql+psycopg://auneron:CHANGE_ME@localhost:5432/auneron_test
TEST_API_KEY=CHANGE_ME_WITH_A_RANDOM_TEST_VALUE_AT_LEAST_32_CHARACTERS
