# Configuração usada somente pelo processo do Vite.
# Variáveis sem o prefixo VITE_ não entram no bundle do navegador.
AUNERON_BACKEND_URL=http://127.0.0.1:8000
AUNERON_API_KEY=CHANGE_ME_WITH_THE_SAME_LOCAL_BACKEND_API_KEY

# Recurso exclusivamente de desenvolvimento já existente no frontend.
VITE_ELEVATED_DEV_CODE=troque-esta-credencial-local
